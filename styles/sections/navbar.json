{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Nav Bar",
	"slug": "section-navbar",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--accent)",
			"text": "var(--wp--preset--color--base)"
		},
		"spacing": {
			"padding": {
				"top": "15px",
				"bottom": "15px"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--highlight)"
					}
				}
			}
		}
	}
}
