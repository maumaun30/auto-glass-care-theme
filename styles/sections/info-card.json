{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Info Card",
	"slug": "info-card",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--surface)"
		},
		"border": {
			"top": {
				"color": "var(--wp--preset--color--accent)",
				"style": "solid",
				"width": "3px"
			}
		},
		"spacing": {
			"padding": {
				"top": "30px",
				"bottom": "30px",
				"left": "30px",
				"right": "30px"
			},
			"blockGap": "0.5rem"
		}
	}
}
