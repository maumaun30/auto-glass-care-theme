{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Review Card",
	"slug": "review-card",
	"blockTypes": [
		"core/quote"
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"border": {
			"left": {
				"color": "var(--wp--preset--color--accent)",
				"style": "solid",
				"width": "4px"
			}
		},
		"spacing": {
			"margin": {
				"top": "0",
				"bottom": "0"
			},
			"padding": {
				"top": "30px",
				"bottom": "30px",
				"left": "30px",
				"right": "30px"
			}
		},
		"typography": {
			"fontStyle": "italic"
		},
		"css": "& cite{display:block;margin-top:1rem;font-style:normal;font-weight:700;color:var(--wp--preset--color--contrast)}"
	}
}
