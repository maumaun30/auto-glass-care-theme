{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#ffffff"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#000000"
				},
				{
					"slug": "foreground",
					"name": "Foreground",
					"color": "#1c1c1c"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#ff0000"
				},
				{
					"slug": "accent-dark",
					"name": "Accent Dark",
					"color": "#a11111"
				},
				{
					"slug": "highlight",
					"name": "Highlight",
					"color": "#eeee22"
				},
				{
					"slug": "gold",
					"name": "Gold",
					"color": "#ffd000"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#f5f5f5"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "#cccccc"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#54595f"
				},
				{
					"slug": "dark",
					"name": "Dark",
					"color": "#3a3a3a"
				}
			],
			"gradients": [
				{
					"slug": "fade-border",
					"name": "Fade Border",
					"gradient": "linear-gradient(180deg, var(--wp--preset--color--border) 0%, rgba(242,41,41,0) 100%)"
				},
				{
					"slug": "overlay-dark",
					"name": "Overlay Dark",
					"gradient": "linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.75) 100%)"
				}
			]
		},
		"layout": {
			"contentSize": "1140px",
			"wideSize": "1400px"
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "clamp(1.25rem, 2vw, 1.5rem)"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "clamp(1.5rem, 3vw, 2.5rem)"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "clamp(2.5rem, 5vw, 3.75rem)"
				},
				{
					"slug": "60",
					"name": "XXL",
					"size": "clamp(3rem, 7vw, 5rem)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Heading (Georgia)",
					"fontFamily": "Georgia, 'Times New Roman', serif"
				},
				{
					"slug": "body",
					"name": "Body (Tahoma)",
					"fontFamily": "Tahoma, Verdana, Segoe, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9375rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "1.875rem",
					"fluid": {
						"min": "1.5rem",
						"max": "1.875rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "2X Large",
					"size": "3.625rem",
					"fluid": {
						"min": "2.1875rem",
						"max": "3.625rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "4.125rem",
					"fluid": {
						"min": "2rem",
						"max": "4.125rem"
					}
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "15px",
				"right": "15px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.625"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"link": {
				"color": {
					"text": "currentColor"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"border": {
					"radius": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": {
						"top": "16px",
						"bottom": "16px",
						"left": "40px",
						"right": "40px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "1.0625rem",
					"fontWeight": "500",
					"textTransform": "capitalize",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-dark)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "1.0625rem",
					"fontWeight": "500",
					"textTransform": "capitalize"
				}
			},
			"core/separator": {
				"color": {
					"text": "currentColor"
				},
				"border": {
					"width": "1px"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontStyle": "italic"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page (No Title Banner)",
			"postTypes": [
				"page"
			]
		}
	]
}
